# Server
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200

# Optional: custom directory for SQLite database (default: ~/.taiga-agent/)
# TAIGA_AGENT_DATA_DIR=./backend/data

# Legacy migration only — on first startup these values are imported into SQLite
# and can then be managed via the app UI (Settings / Workspaces).
# TAIGA_URL=https://api.taiga.io/api/v1
# TAIGA_USERNAME=your@email.com
# TAIGA_PASSWORD=your-password
# TAIGA_TOKEN=
# TAIGA_PROJECT_ID=123456
# TAIGA_PROJECT_SLUG=your-project-slug
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
# GITLAB_URL=https://gitlab.com/api/v4
# GITLAB_TOKEN=glpat-xxxxxxxx
# GITLAB_PROJECT_ID=12345
# GITLAB_DEFAULT_BASE=develop
# VALID_SCOPES=App,Backend,Portal
# VALID_TASK_DOMAINS=Pedido,Checkout,Pagamento
