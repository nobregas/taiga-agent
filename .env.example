# Server
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Taiga.io
TAIGA_URL=https://api.taiga.io/api/v1
TAIGA_USERNAME=your@email.com
TAIGA_PASSWORD=your-password
# Optional: use a pre-obtained token instead of username/password
# TAIGA_TOKEN=
TAIGA_PROJECT_ID=123456
TAIGA_PROJECT_SLUG=your-project-slug

# Gemini (Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# GitLab (optional — retrospectiva / enrich mode)
# GITLAB_URL=https://gitlab.com/api/v4
# GITLAB_TOKEN=glpat-xxxxxxxx
# GITLAB_PROJECT_ID=12345
# GITLAB_DEFAULT_BASE=develop

# Optional: fixed scope dropdown values (comma-separated)
# VALID_SCOPES=App,Backend,Portal,Pedido,Checkout

# Task domain prefixes — NOT the US scope
# VALID_TASK_DOMAINS=Pedido,Checkout,Pagamento,Pedidos,Catalogo
